# ==============================================================================
# Concord — Variáveis de Ambiente de Produção
# ==============================================================================

NODE_ENV=production
PORT=3001

# Chave de API opcional para servidores TURN/STUN Metered.ca
# Se não fornecido, o Concord usará o conjunto fallback integrado de servidores STUN/TURN
METERED_API_KEY=

# URL pública oficial de produção (utilizada por links e integrações)
PUBLIC_URL=https://concord.seudominio.com
