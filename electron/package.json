{
  "name": "concord-desktop",
  "version": "1.0.0",
  "description": "Concord Desktop App with System Screen & Audio Capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": ["concord", "discord", "webrtc", "electron"],
  "author": "Concord Team",
  "license": "MIT",
  "build": {
    "appId": "com.concord.desktop",
    "productName": "Concord",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../client/public/favicon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network;Chat;"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.social-networking"
    }
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
