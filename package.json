{
  "name": "concord",
  "version": "1.0.0",
  "description": "Concord - Discord Clone with Screen Sharing, Voice Calls, Servers and Private Chat",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "desktop": "cd electron && (test -d node_modules || npm install) && npm start",
    "desktop:install": "cd electron && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
